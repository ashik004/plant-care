    { "key": "Anthurium", "rank": "genus", "common": "Anthurium", "waterEvery": 7, "light": "Bright indirect", "lux": [3000, 12000], "humidity": [60, 80], "temp": [18, 27], "amount": "200 ml", "toxicToPets": true, "care": "Water when the top few centimetres are dry. More light means more flowers." },
    { "key": "Syngonium", "rank": "genus", "common": "Arrowhead plant", "waterEvery": 6, "light": "Medium", "lux": [1000, 8000], "humidity": [50, 70], "temp": [16, 27], "amount": "200 ml", "toxicToPets": true, "care": "Keep the soil lightly moist. Pinch back climbing stems to keep the arrow-shaped leaves compact." },
    { "key": "Alocasia", "rank": "genus", "common": "Elephant ear", "waterEvery": 6, "light": "Bright indirect", "lux": [3000, 12000], "humidity": [60, 80], "temp": [18, 28], "amount": "250 ml", "toxicToPets": true, "care": "Likes warmth and humidity. It may drop a leaf as it grows a new one; that's normal." },
    { "key": "Chlorophytum", "rank": "genus", "common": "Spider plant", "waterEvery": 7, "light": "Medium to bright", "lux": [1500, 15000], "humidity": [40, 60], "temp": [13, 27], "amount": "200 ml", "toxicToPets": false, "care": "Easy and pet-safe. Pot up the baby plantlets to share." },
    { "key": "Peperomia", "rank": "genus", "common": "Peperomia", "waterEvery": 10, "light": "Medium", "lux": [1000, 8000], "humidity": [40, 60], "temp": [16, 26], "amount": "150 ml", "toxicToPets": false, "care": "Semi-succulent leaves store water. Let the soil dry out between drinks." },
