    { "key": "Schefflera", "rank": "genus", "common": "Umbrella plant", "waterEvery": 9, "light": "Bright indirect", "lux": [3000, 15000], "humidity": [40, 60], "temp": [15, 27], "amount": "300 ml", "toxicToPets": true, "care": "Water when the top half of the soil is dry. Prune to keep it bushy." },
    { "key": "Chamaedorea", "rank": "genus", "common": "Parlour palm", "waterEvery": 7, "light": "Low to medium", "lux": [800, 6000], "humidity": [40, 60], "temp": [16, 27], "amount": "250 ml", "toxicToPets": false, "care": "Keep the soil lightly moist. Tolerates lower light than most palms." },
