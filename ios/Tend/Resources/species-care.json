    { "key": "Pilea", "rank": "genus", "common": "Pilea", "waterEvery": 7, "light": "Bright indirect", "lux": [2000, 12000], "humidity": [40, 65], "temp": [13, 27], "amount": "150 ml", "toxicToPets": false, "care": "Water when the top half of the soil is dry and turn it regularly." },
