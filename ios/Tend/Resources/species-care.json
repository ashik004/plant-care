  "note": "Starter care data for common houseplants. Values are general guidance; review with a horticulturist before launch. Lookup order: species, then genus, then family, then 'default'. lux is the comfortable light range; humidity in %, temp in °C, waterEvery in days. toxicToPets follows ASPCA listings where known (null = unknown).",
  "entries": [
    { "key": "Spathiphyllum", "rank": "genus", "common": "Peace lily", "waterEvery": 6, "light": "Medium", "lux": [1000, 6000], "humidity": [50, 70], "temp": [18, 27], "amount": "300 ml", "toxicToPets": true, "care": "Droops dramatically when thirsty and perks up within hours. Keep it away from cold draughts and wipe the leaves monthly." },
    { "key": "Monstera deliciosa", "rank": "species", "common": "Monstera", "waterEvery": 7, "light": "Bright indirect", "lux": [3000, 15000], "humidity": [40, 70], "temp": [18, 27], "amount": "400 ml", "toxicToPets": true, "care": "Let the top third of the soil dry between drinks. Give it a moss pole to climb and bright, indirect light for split leaves." },
    { "key": "Monstera", "rank": "genus", "common": "Monstera", "waterEvery": 7, "light": "Bright indirect", "lux": [3000, 15000], "humidity": [50, 75], "temp": [18, 27], "amount": "300 ml", "toxicToPets": true, "care": "Water when the top few centimetres are dry. Likes humidity and something to climb." },
    { "key": "Epipremnum aureum", "rank": "species", "common": "Golden pothos", "waterEvery": 7, "light": "Low to bright", "lux": [1000, 10000], "humidity": [40, 70], "temp": [15, 29], "amount": "250 ml", "toxicToPets": true, "care": "Very forgiving. Water when the top half of the soil is dry, and trim leggy vines to keep it full." },
    { "key": "Epipremnum", "rank": "genus", "common": "Pothos", "waterEvery": 7, "light": "Low to bright", "lux": [1000, 10000], "humidity": [40, 70], "temp": [15, 29], "amount": "250 ml", "toxicToPets": true, "care": "Water when the top half of the soil is dry. Trim long vines to keep it bushy." },
    { "key": "Ficus lyrata", "rank": "species", "common": "Fiddle-leaf fig", "waterEvery": 9, "light": "Bright indirect", "lux": [5000, 20000], "humidity": [45, 65], "temp": [16, 26], "amount": "350 ml", "toxicToPets": true, "care": "Hates being moved and hates cold draughts. Water when the top 5 cm are dry and rotate it a quarter turn each month." },
    { "key": "Ficus elastica", "rank": "species", "common": "Rubber plant", "waterEvery": 9, "light": "Bright indirect", "lux": [3000, 15000], "humidity": [40, 60], "temp": [16, 27], "amount": "300 ml", "toxicToPets": true, "care": "Let the top half of the soil dry out. Dust the big leaves so they can take in light." },
    { "key": "Ficus", "rank": "genus", "common": "Fig", "waterEvery": 8, "light": "Bright indirect", "lux": [3000, 15000], "humidity": [40, 65], "temp": [16, 27], "amount": "300 ml", "toxicToPets": true, "care": "Keep it in one bright spot; figs drop leaves when moved. Water when the top few centimetres are dry." },
    { "key": "Dracaena trifasciata", "rank": "species", "common": "Snake plant", "waterEvery": 21, "light": "Low to bright", "lux": [500, 20000], "humidity": [30, 60], "temp": [15, 29], "amount": "200 ml", "toxicToPets": true, "care": "Thrives on neglect. Let the soil dry out completely, and water even less in winter." },
    { "key": "Sansevieria", "rank": "genus", "common": "Snake plant", "waterEvery": 21, "light": "Low to bright", "lux": [500, 20000], "humidity": [30, 60], "temp": [15, 29], "amount": "200 ml", "toxicToPets": true, "care": "Thrives on neglect. Let the soil dry out completely between drinks." },
    { "key": "Dracaena", "rank": "genus", "common": "Dracaena", "waterEvery": 10, "light": "Medium", "lux": [1000, 10000], "humidity": [40, 60], "temp": [16, 27], "amount": "250 ml", "toxicToPets": true, "care": "Water when the top half of the soil is dry. Brown tips usually mean fluoride in tap water or dry air." },
    { "key": "Zamioculcas zamiifolia", "rank": "species", "common": "ZZ plant", "waterEvery": 18, "light": "Low to medium", "lux": [300, 8000], "humidity": [30, 60], "temp": [15, 26], "amount": "250 ml", "toxicToPets": true, "care": "Stores water in its rhizomes. Water only when the soil is fully dry; overwatering is the main risk." },
    { "key": "Calathea", "rank": "genus", "common": "Calathea", "waterEvery": 5, "light": "Medium", "lux": [1000, 5000], "humidity": [60, 80], "temp": [18, 26], "amount": "200 ml", "toxicToPets": false, "care": "Keep the soil lightly moist and the air humid. Use filtered or rain water; crispy edges mean dry air or hard water." },
    { "key": "Goeppertia", "rank": "genus", "common": "Calathea", "waterEvery": 5, "light": "Medium", "lux": [1000, 5000], "humidity": [60, 80], "temp": [18, 26], "amount": "200 ml", "toxicToPets": false, "care": "Keep the soil lightly moist and the air humid. Use filtered or rain water; crispy edges mean dry air or hard water." },
    { "key": "Maranta", "rank": "genus", "common": "Prayer plant", "waterEvery": 5, "light": "Medium", "lux": [1000, 5000], "humidity": [55, 80], "temp": [18, 26], "amount": "200 ml", "toxicToPets": false, "care": "Folds its leaves up at night. Keep the soil evenly moist and out of direct sun." },
    { "key": "Nephrolepis", "rank": "genus", "common": "Boston fern", "waterEvery": 3, "light": "Medium", "lux": [1000, 5000], "humidity": [50, 80], "temp": [16, 24], "amount": "200 ml", "toxicToPets": false, "care": "Never let it dry out completely. Loves a steamy bathroom." },
    { "key": "Adiantum", "rank": "genus", "common": "Maidenhair fern", "waterEvery": 2, "light": "Medium", "lux": [1000, 5000], "humidity": [60, 85], "temp": [16, 24], "amount": "150 ml", "toxicToPets": false, "care": "Keep the soil constantly moist and the air humid. Fronds crisp within a day if it dries out." },
    { "key": "Asplenium", "rank": "genus", "common": "Bird's nest fern", "waterEvery": 5, "light": "Low to medium", "lux": [800, 5000], "humidity": [50, 80], "temp": [16, 27], "amount": "200 ml", "toxicToPets": false, "care": "Water around the soil, not into the central rosette, to avoid rot." },
    { "key": "Philodendron", "rank": "genus", "common": "Philodendron", "waterEvery": 7, "light": "Medium to bright", "lux": [1500, 12000], "humidity": [50, 75], "temp": [16, 27], "amount": "250 ml", "toxicToPets": true, "care": "Water when the top third of the soil is dry. Climbing types grow bigger leaves with a moss pole." },
    { "key": "Aglaonema", "rank": "genus", "common": "Chinese evergreen", "waterEvery": 10, "light": "Low", "lux": [300, 4000], "humidity": [40, 60], "temp": [18, 27], "amount": "250 ml", "toxicToPets": true, "care": "Slow and forgiving. Let the top half of the soil dry out between drinks." },
